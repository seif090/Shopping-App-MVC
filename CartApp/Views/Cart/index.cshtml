@model IEnumerable<CartApp.Models.CartItem>

<h2>Shopping Cart</h2>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>$@item.Product.Price</td>
                <td>
                    <input type="number" value="@item.Quantity" min="1" 
                           onchange="updateQuantity(@item.Product.Id, this.value)" />
                </td>
                <td>$@(item.Product.Price * item.Quantity)</td>
                <td>
                    <button class="btn btn-danger" onclick="removeItem(@item.Product.Id)">Remove</button>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3"><strong>Total:</strong></td>
            <td>$@Model.Sum(item => item.Product.Price * item.Quantity)</td>
            <td></td>
        </tr>
    </tfoot>
</table>